# Gemini (free tier — https://aistudio.google.com)
GEMINI_API_KEY=

# Telegram (@BotFather) — optional for local --local-email testing,
# required for live mode
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail OAuth — only needed for live mode (--local-email doesn't touch Gmail)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Conta do Gmail usada nos links das notificações (authuser=)
GMAIL_ACCOUNT=
